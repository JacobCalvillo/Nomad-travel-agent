Screen {
    background: #0d1117;
    color: #e6edf3;
}

#chat-container {
    padding: 1 2;
}

.message {
    width: 100%;
    margin: 0 0 1 0;
}

.user .user-text {
    color: #7ee787;
    text-style: bold;
}

.status .status-text {
    color: #8b949e;
    text-style: italic;
}

.assistant Markdown {
    background: transparent;
    padding: 0;
    margin: 0;
    color: #e6edf3;
}

.assistant MarkdownTableHead {
    background: #21262d;
    color: #e6edf3;
    text-style: bold;
}

.assistant MarkdownTableRow {
    background: #161b22;
    color: #e6edf3;
}

.assistant MarkdownTableRow.-even {
    background: #0d1117;
}

Input {
    dock: bottom;
    height: 3;
    margin: 1 2;
    background: #161b22;
    border: solid #30363d;
    color: white;
}

Footer {
    background: #161b22;
}